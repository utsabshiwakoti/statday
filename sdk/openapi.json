{
  "openapi": "3.1.0",
  "info": {
    "title": "StatDay API",
    "summary": "Canadian statutory holidays and business days.",
    "description": "\nStatutory and public holidays for every Canadian province and territory, plus federally regulated\nworkplaces, from 2023 to 2050. Also: observed days off when a holiday lands on a weekend,\nand business-day maths (count them, or add them to a date).\n\n**Authentication.** Optional. Send an API key in the `X-API-Key` header for a higher rate limit.\nGet one free in the [developer portal](/portal).\n\n**Rate limits.** Every response has `RateLimit-Limit`, `RateLimit-Remaining` and `RateLimit-Reset`\nheaders. Going over returns `429` with `Retry-After`.\n\n**Caching.** Responses carry an `ETag`. Send it back in `If-None-Match` to get `304 Not Modified`\nwhen nothing changed.\n\n**Errors.** Always `application/problem+json` ([RFC 9457](https://www.rfc-editor.org/rfc/rfc9457)).\nThe `type` field links to an explanation in the [guide](/guide).\n",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/regions": {
      "get": {
        "tags": [
          "regions"
        ],
        "summary": "List regions",
        "description": "The federal jurisdiction (`CA`, for federally regulated workplaces) plus every province and territory.",
        "operationId": "list_regions",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionList"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: your `If-None-Match` ETag is still current."
          },
          "401": {
            "description": "The API key is invalid or revoked.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "A parameter is invalid or out of range.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit reached; see `Retry-After`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
