    "/v1/holidays": {
      "get": {
        "tags": [
          "holidays"
        ],
        "summary": "Search holidays",
        "description": "Holidays across Canada between two dates, with the regions observing each one.\n\nFilters narrow both the holidays and their `regions` list (e.g. `region=ON&type=statutory`).\nResults are paginated: see `pagination` in the body, or the `Link` and `X-Total-Count` headers.",
        "operationId": "list_holidays",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Shorthand for `start` and `end` covering one year.",
              "title": "Year"
            },
            "description": "Shorthand for `start` and `end` covering one year."
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defaults to January 1 of the current year.",
              "title": "Start"
            },
